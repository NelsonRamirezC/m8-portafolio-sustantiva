<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container">
        <a class="navbar-brand" href="#">M8 - Portafolio</a>
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav ms-auto">
                <a class="nav-link active" aria-current="page" href="/">Home</a>
                <a class="nav-link" href="/productos">Productos</a>
                <a class="nav-link" href="/usuarios">Usuarios</a>
                <a class="nav-link" href="/ventas">Ventas</a>
                <a class="nav-link" href="/login">Login</a>
                <a class="nav-link" href="/register">Registro</a>

                <a class="nav-link fw-bold" href="/carrito" id="carrito-link">Carrito: <span id="cantidad-carrito">0</span></a>
                <a href="" id="logout-link" class="nav-link">Logout</a>
            </div>
        </div>
    </div>
</nav>


<script>

    //ENLACES
    const logoutLink = document.querySelector("#logout-link");
    const carritoLink = document.querySelector("#carrito-link");


    const init = async () => {
        let usuario = JSON.parse(localStorage.getItem("usuario"));
        if(usuario){
            let response = await fetch("/api/carritos/cantidad/"+usuario.id);
        let data = await response.json();
        console.log(data);
        document.querySelector("#cantidad-carrito").textContent = data.cantidad;
        }
        
    }
    init();


    logoutLink.addEventListener("click", (event) => {
        event.preventDefault();

        localStorage.clear();
        alert("Sesión cerrada correctamente.");
        location.href = "/";

    });


    carritoLink.addEventListener("click", (event) => {
        event.preventDefault();
        let usuario = JSON.parse(localStorage.getItem("usuario"));
        if(usuario){

            location.href = "/carrito/"+usuario.id;
        }
    })

</script>